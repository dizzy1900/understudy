# Single-quote the key: Crusoe keys can contain '$', which a double-quoted value would expand.
CRUSOE_API_KEY=''
BUDGET_USD=20
DEMO_MODE=0
# Extra comma-separated origins allowed by CORS (dev origins on :5173 are always allowed). "*" is ignored.
UNDERSTUDY_CORS_ORIGINS=
# SQLite snapshot the read-only Vercel API serves (default data/understudy.db).
# UNDERSTUDY_DB=data/understudy.db
